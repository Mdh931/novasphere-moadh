# Documentaire : NON appliqué dans le Learner Lab, qui refuse la création
# d'un fournisseur OIDC. Dans un compte AWS classique, ce fichier renommé en .tf
# remplacerait les identifiants de session stockés dans les secrets du dépôt.

data "aws_caller_identity" "current" {}

# Fournisseur d'identité : AWS fait confiance aux jetons émis par GitHub Actions
resource "aws_iam_openid_connect_provider" "github" {
  url            = "https://token.actions.githubusercontent.com"
  client_id_list = ["sts.amazonaws.com"]
}

# Politique de confiance : seuls les runs de CE dépôt peuvent prendre le rôle
data "aws_iam_policy_document" "ci_trust" {
  statement {
    actions = ["sts:AssumeRoleWithWebIdentity"]

    principals {
      type        = "Federated"
      identifiers = [aws_iam_openid_connect_provider.github.arn]
    }

    condition {
      test     = "StringEquals"
      variable = "token.actions.githubusercontent.com:aud"
      values   = ["sts.amazonaws.com"]
    }

    # PR (plan), environnements dev et prod (apply), main (dérive)
    condition {
      test     = "StringLike"
      variable = "token.actions.githubusercontent.com:sub"
      values = [
        "repo:Mdh931/novasphere-moadh:pull_request",
        "repo:Mdh931/novasphere-moadh:environment:dev",
        "repo:Mdh931/novasphere-moadh:environment:prod",
        "repo:Mdh931/novasphere-moadh:ref:refs/heads/main",
      ]
    }
  }
}

resource "aws_iam_role" "ci" {
  name                 = "novasphere-ci"
  assume_role_policy   = data.aws_iam_policy_document.ci_trust.json
  max_session_duration = 3600
}

# Droits de déploiement. En production, on les restreindrait aux services
# utilisés (EC2, ELB, Auto Scaling, SSM, S3 du state).
resource "aws_iam_role_policy_attachment" "ci_power_user" {
  role       = aws_iam_role.ci.name
  policy_arn = "arn:aws:iam::aws:policy/PowerUserAccess"
}

# PowerUserAccess exclut IAM : il faut autoriser l'attachement du profil aux instances
data "aws_iam_policy_document" "ci_pass_role" {
  statement {
    actions   = ["iam:PassRole"]
    resources = ["arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/novasphere-instance-*"]
  }
}

resource "aws_iam_role_policy" "ci_pass_role" {
  name   = "pass-role-instances"
  role   = aws_iam_role.ci.id
  policy = data.aws_iam_policy_document.ci_pass_role.json
}

output "ci_role_arn" {
  value = aws_iam_role.ci.arn
}

# Côté workflow, les trois secrets AWS disparaissent et sont remplacés par :
#
#   permissions:
#     id-token: write
#     contents: read
#
#   - uses: aws-actions/configure-aws-credentials@v4
#     with:
#       role-to-assume: <valeur de ci_role_arn>
#       aws-region: us-east-1
